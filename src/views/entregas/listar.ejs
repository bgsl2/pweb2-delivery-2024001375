<!-- src/views/entregas/index.ejs -->
<%- include('../partials/header', { titulo: 'Entregas' }) %>
  <%- include('../partials/navbar') %>

    <main class="container">
      <div class="page-header">
        <h1>Entregas</h1>
        <a href="/entregas/new" class="btn btn-primary">Nova Entrega</a>
      </div>

      <% if (entregas.length===0) { %>
        <p class="empty-state">Nenhuma entrega cadastrada ainda.</p>
        <% } else { %>
          <table class="table">
            <thead>
              <tr>
                <th>ID</th>
                <th>Descrição</th>
                <th>Origem</th>
                <th>Destino</th>
                <th>Status</th>
                <th>Motorista ID</th>
                <th>Ações</th>
              </tr>
            </thead>
            <tbody>
              <% entregas.forEach(e=> { %>
                <tr>
                  <td>
                    <%= e.id %>
                  </td>
                  <td>
                    <%= e.descricao %>
                  </td>
                  <td>
                    <%= e.origem %>
                  </td>
                  <td>
                    <%= e.destino %>
                  </td>
                  <td>
                    <%= e.status %>
                  </td>
                  <td>
                    <%= e.motoristaId ?? 'Não atribuído' %>
                  </td>
                  <td class="actions">
                    <a href="/entregas/<%= e.id %>">Ver</a>
                    <a href="/entregas/<%= e.id %>/historico">Histórico</a>
                  </td>
                </tr>
                <% }); %>
            </tbody>
          </table>
          <% } %>
    </main>

    <%- include('../partials/footer') %>
