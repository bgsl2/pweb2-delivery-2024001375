// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Entregas {
                id        Int    @id @default(autoincrement())
                descricao String 
                origem    String
                destino   String
                status    String @default("CRIADO")

                motorista   Motorista? @relation(fields: [motoristaId], references: [id])
                motoristaId Int?       @map("motorista_id")

                historico   Historico[]

                @@map("Entregas")
        }
model Historico { 
                id        int      @id @default(autoincrement())
                data      DateTime @default(now())
                descricao String

                entrega   Entregas @relation(fields: [entregaId], references: [id], onDelete: Cascade)
                entregaId Int      @map("entrega_id")

                @@map("Historico")
        }
model Motorista {
        id           Int @id @default(autoincrement())
        nome         String
        cpf          String @unique
        placaVeiculo String @map("placa_veiculo")
        status       String @default("ATIVO")

        entregas Entregas[]
        @@map("Motorista")
        }
